# API Configuration
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle, and it
# inlines them at BUILD time — the value is baked into the JS, so changing it
# means rebuilding, not restarting.
#
# Which file Vite reads is decided by the command:
#   npm run dev     -> .env  +  .env.development
#   npm run build   -> .env  +  .env.production
# A VITE_ variable already present in the shell (or set by Docker ENV) beats
# both files.

# Local development — Spring Boot running on your machine
VITE_API_BASE_URL=http://localhost:8099/compliancePortal/

# Live server (see .env.production):
# VITE_API_BASE_URL=https://replportal.co.in:8443/compliancePortal/
