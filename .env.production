# API Configuration — PRODUCTION / LIVE SERVER
#
# Vite loads this automatically during `npm run build` (mode=production) and it
# overrides .env, so a production build never depends on remembering to edit a
# file first.
#
# The Docker build passes --build-arg VITE_API_BASE_URL, which overrides even
# this — see the Jenkinsfile 'Build Docker Image' stage.

# VITE_API_BASE_URL=https://replportal.co.in:8443/compliancePortal/
VITE_API_BASE_URL=http://localhost:8099/compliancePortal/

